<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 引擎常驻与开机 / 更新自激活所需，全部为普通权限，不申请联网。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      一个 APK 同时承担两个角色：
        · LSPosed 模块（META-INF/xposed/java_init.list）注入 FV 进程，纯 Java，不碰 native；
        · OCR 引擎宿主：自带 libmiocr.so，OcrProvider / OcrService / BootReceiver
          全部跑在模块【主进程】，native 调用只发生在真正识别时（lazy）。

      v2.0.2 关键修复（真机日志 LSPosed_20261108_170719.zip 钉死的根因）：
        · v2.0.0/2.0.1 把 Provider/Service/Receiver 放在 :ocr 子进程，而
          「激活 :ocr」这件事本身又需要 :ocr 进程先启动 —— 循环依赖。
        · HyperOS/MIUI 把 com.fvocr.bridge 整个包的后台冷启动全禁了，连系统投递的
          MY_PACKAGE_REPLACED 都被拦：
            BroadcastQueueInjector: Unable to launch app ... process is not permitted to auto start
            WakePathChecker: MIUILOG-AutoStart, Service/Provider/Broadcast Reject
              classname=OcrProvider wakeType=4 / OcrService wakeType=8 / BootReceiver wakeType=2
          于是 am broadcast 的 result=0 只是广播队列处理完，Receiver 根本没执行，
          :ocr 进程 0 次启动，FV 侧一直 Unknown authority。
        · 日志标题明确写的是 "Service/Provider/Broadcast Reject"：显式 startActivity
          不在这道管控里（同份日志里多次 START ... result code=0）。

      因此 v2.0.2 做两件事：
        ① 所有组件收回主进程，链路缩到最短：主进程一起 = Provider 已发布 + 前台服务常驻，
           不再有第二次进程冷启动，也不再依赖「应用自己拉起自己的子进程」这一未经验证的路径。
        ② 增加 WakeActivity（透明、exported）+ LAUNCHER 图标，给用户一条显式 Activity 启动入口。
           点图标或 am start -n 即可让主进程活起来；Activity 内同应用直启 OcrService 前台保活。
           加图标同时解决 "MST_PackageCache: com.fvocr.bridge has not launcher icon,return" ——
           应用才会出现在 MIUI 自启动管理列表里，可手动放行。设置页里可一键隐藏图标。

      代价：放弃 :ocr 子进程的 native 崩溃隔离。MiOcrStandalone v1.0.3 已修掉导致 abort() 的
      uses-native-library / OpenCL namespace 根因，引擎稳定；且 OcrProvider.onCreate() 仍零 native。
    -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:description="@string/module_description">

        <!--
          Android 12(API 31)+ 普通 App 默认处于 classloader-namespace，
          不能 dlopen /vendor 下的私有原生库。libmiocr.so 用 MACE 的 OpenCL 后端，
          需要 clGetPlatformIDs() 拿到 GPU platform；缺声明会枚举到 0 个平台，
          MACE 的 glog CHECK 失败 → abort() → SIGABRT（native 崩溃 Java 拦不住）。
          下面 26 个声明照抄小米相册 APK（23 个）+ MACE 硬编码候选（3 个 OpenCL 实现）。
          全部 required=false：机型上不存在的库直接跳过，不影响安装。
        -->
        <uses-native-library android:name="libapuwareutils_v2.mtk.so" android:required="false" />
        <uses-native-library android:name="libneuronusdk_adapter.mtk.so" android:required="false" />
        <uses-native-library android:name="libc++.so" android:required="false" />
        <uses-native-library android:name="libbase.so" android:required="false" />
        <uses-native-library android:name="ld-android.so" android:required="false" />
        <uses-native-library android:name="libdl_android.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libcgrouprc.so" android:required="false" />
        <uses-native-library android:name="libprocessgroup.so" android:required="false" />
        <uses-native-library android:name="libcutils.so" android:required="false" />
        <uses-native-library android:name="libutils.so" android:required="false" />
        <uses-native-library android:name="libhardware.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libhidlbase.so" android:required="false" />
        <uses-native-library android:name="vendor.qti.hardware.dsp@1.0..so" android:required="false" />
        <uses-native-library android:name="libdmabufheap.so" android:required="false" />
        <uses-native-library android:name="libvmmem.so" android:required="false" />
        <uses-native-library android:name="libbinder.so" android:required="false" />
        <uses-native-library android:name="libqape.qti.so" android:required="false" />
        <uses-native-library android:name="libSNPE.so" android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libsdsprpc.so" android:required="false" />
        <uses-native-library android:name="libGLES_mali.so" android:required="false" />
        <uses-native-library android:name="libOpenCL-pixel.so" android:required="false" />
        <uses-native-library android:name="libPVROCL.so" android:required="false" />

        <!--
          v2.0.2：对外 OCR 接口跑在【主进程】。进程一起系统就 installContentProviders，
          Provider 立即发布；此后 FV 的 call 走「进程已运行」分支，不再触发
          ContentProviderHelper 的 "Unable to launch app" 与 WakePathChecker。
          exported=true、无权限：FV 进程与 shell 都能直接 call。
        -->
        <provider
            android:name=".OcrProvider"
            android:authorities="com.fvocr.bridge.ocr"
            android:exported="true" />

        <!-- v2.0.2：主进程前台常驻。由 WakeActivity（前台、同应用）直接启动。 -->
        <service
            android:name=".OcrService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          开机 / 覆盖安装 / 手动 WAKE 的兼容入口（主进程）。
          MIUI 上这些广播可能被拦，仅作补充；主激活路径是 WakeActivity。
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.fvocr.bridge.WAKE" />
            </intent-filter>
        </receiver>

        <!--
          v2.0.2 显式激活入口：透明、立即结束，不留界面、不进最近任务。
          exported=true 让桌面图标 / am start -n / FV 侧显式兜底都能启动它。
          它只做一件事：同应用直启 OcrService 前台保活。
          显式 startActivity 不在 MIUI "Service/Provider/Broadcast Reject" 管控里。
        -->
        <activity
            android:name=".WakeActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          v2.0.2：桌面图标（alias 指向 WakeActivity）。
          有 LAUNCHER 后应用才会被 MIUI 自启动管理列出，用户才能手动放行；
          点一下图标 = 一次显式 Activity 启动 = 主进程激活 + 引擎常驻。
          不想要图标可在设置页点「隐藏桌面图标」，MainActivity 仍可从 LSPosed 进入。
        -->
        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".WakeActivity"
            android:label="@string/app_name"
            android:icon="@android:drawable/sym_def_app_icon"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 模块设置页：MODULE_SETTINGS，从 LSPosed 模块列表进入，可查看状态 / 自检 / 隐藏图标。 -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>

</manifest>
